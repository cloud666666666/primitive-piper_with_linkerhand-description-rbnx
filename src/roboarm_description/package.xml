<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>roboarm_description</name>
  <version>0.1.0</version>
  <description>
    AgileX Piper (gripper removed) + Ø39 mm coaxial adapter + LinkerHand O6
    right hand: URDF and meshes for robot_state_publisher. The mesh set is
    vendored from AgileX piper_description and the LinkerHand O6 URDF
    package; the URDF itself is generated by urdf/make_urdf.py.
  </description>
  <maintainer email="2353493891@qq.com">Joker.Yun</maintainer>
  <license>MulanPSL-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- robot_state_publisher is what actually consumes the URDF; the launch
       file lives at the rbnx package root (launch/roboarm_urdf.launch.py)
       and is invoked with `ros2 launch`, so it needs launch + launch_ros.
       joint_state_publisher / rviz2 / xacro are deliberately NOT depended
       on: joint feedback comes from the real driver (/arm/joint_states_single),
       boot is headless, and the URDF is pre-expanded (no xacro pass). -->
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
